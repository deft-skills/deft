# API keys and models for the optional LLM judges of C5 (experiments/c5_contracts).
# Copy to .env (never committed) and fill in the keys. A provider without a key is skipped.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Models (change to the ones you want to compare)
DEFT_JUDGE_ANTHROPIC_MODEL=claude-opus-5-5
DEFT_JUDGE_OPENAI_MODEL=gpt-6-astra
DEFT_JUDGE_GOOGLE_MODEL=gemini-3.1-pro-preview
